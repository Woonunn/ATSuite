# 复制到仓库根目录 .env；只取消注释你实际使用的平台配置，并替换示例值。
# 已有进程环境变量优先。修改后重启 Web/worker；.env 不提交到 Git。
# 完整步骤、权限和只读身份检查：docs/userguide/cloud-env.md

# LLM Advisor：规格/Web 选择 advisor.provider="deepseek"。
# 配置只影响推荐器 Advisor；trace 中 llm 节点仍按记录时长回放。
DEEPSEEK_API_KEY=
ATSUITE_ADVISOR_MODEL=deepseek-flash

# === ATSuite cloud configuration reference ===
# AWS：aws_lambda / aws_agentcore。凭证方式二选一。
# 方式 A：先 aws configure --profile atsuite，再设置 profile；不要填空的 AK 变量。
# AWS_PROFILE=atsuite
# 方式 B：填写 AK/SK；STS 临时凭证还必须填写对应 token。
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_ACCOUNT_ID=123456789012
# AWS_REGION=us-east-1
# AWS_DEFAULT_REGION=us-east-1
# ECR_REPOSITORY_NAME=atsuite
# Lambda / AgentCore 分别需要预先建立的执行角色，不是本地登录凭证。
# AWS_LAMBDA_ROLE_ARN=arn:aws:iam::123456789012:role/atsuite-lambda-execution-role
# AWS_AGENTCORE_ROLE_ARN=arn:aws:iam::123456789012:role/atsuite-agentcore-execution-role

# Alibaba Cloud：ali_fc / ali_agentrun（后者目前是 FC MCP SESSION_EXCLUSIVE）。
# 本地 SDK/aliyun CLI 使用同一组 RAM 用户或 STS 凭证。
# ALIBABA_CLOUD_ACCESS_KEY_ID=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# ALIBABA_CLOUD_SECURITY_TOKEN=
# CLI 已有 profile 时确认身份一致；选用纯环境凭证可设置以下选项忽略 CLI profile。
# ALIBABA_CLOUD_IGNORE_PROFILE=TRUE
# ALI_ACCOUNT_ID=1234567890123456
# ALI_REGION=cn-hangzhou
# ALIBABA_CLOUD_REGION_ID=cn-hangzhou
# ALI_ENDPOINT=1234567890123456.cn-hangzhou.fc.aliyuncs.com
# DOCKERHUB_NAME=registry.cn-hangzhou.aliyuncs.com/your-namespace/atsuite
# FC 执行角色须具有日志写入及所需 OSS 状态访问权限。
# ALI_FC_ROLE_ARN=acs:ram::1234567890123456:role/atsuite-fc-execution-role
# 预先建立的日志项目/store；部署和采集项目、地区须对应。
# ATSUITE_SLS_PROJECT=atsuite-logs
# ATSUITE_SLS_LOGSTORE=atsuite-runtime
# ATSUITE_ALI_SLS_PROJECT=atsuite-logs
# ATSUITE_ALI_SLS_LOCATION=cn-hangzhou
# 仅旧式 tools.deploy 非实验路径需要以下 OSS AK/SK；默认推荐器使用执行角色。
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=

# Google Cloud：gcp_faas / gcp_mcp，目前均使用 Cloud Run。
# GOOGLE_CLOUD_PROJECT=your-project-id
# GCP_REGION=us-central1
# GCP_ARTIFACT_REPOSITORY=atsuite
# GCP_BUCKET=your-existing-gcs-state-bucket
# SDK：gcloud auth application-default login，或指定 ADC 凭证文件（方式二选一）。
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/gcp-credentials.json
# gcloud CLI：另执行 gcloud auth login，或显式指定它自己的凭证文件。
# CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE=/absolute/path/gcp-credentials.json
# 仅旧式独立部署镜像命名使用此前缀；推荐器用 GCP_ARTIFACT_REPOSITORY/registry 映射。
# GCP_IMAGE_PREFIX=us-central1-docker.pkg.dev/your-project-id/atsuite

# 共用执行配置。以下 JSON 必须保持单行；只保留本次实验使用的 provider。
# 默认执行不会创建状态 bucket，需预建并授权相应运行角色读写。
# ATSUITE_STATE_BUCKETS='{"aws_lambda":"your-s3-state-bucket","aws_agentcore":"your-s3-state-bucket","ali_fc":"your-oss-state-bucket","ali_agentrun":"your-oss-state-bucket","gcp_faas":"your-gcs-state-bucket","gcp_mcp":"your-gcs-state-bucket"}'
# 可选：按 provider 显式指定完整镜像仓库路径。路径不含 tag/digest。
# ATSUITE_REGISTRY_REPOSITORIES='{"aws_lambda":"123456789012.dkr.ecr.us-east-1.amazonaws.com/atsuite","aws_agentcore":"123456789012.dkr.ecr.us-east-1.amazonaws.com/atsuite","ali_fc":"registry.cn-hangzhou.aliyuncs.com/your-namespace/atsuite","ali_agentrun":"registry.cn-hangzhou.aliyuncs.com/your-namespace/atsuite","gcp_faas":"us-central1-docker.pkg.dev/your-project-id/atsuite/runtime","gcp_mcp":"us-central1-docker.pkg.dev/your-project-id/atsuite/runtime"}'
# 只有工具含 init.sh 时需要固定摘要的隔离初始化镜像；替换成真实 64 位 SHA256。
# ATSUITE_INIT_IMAGE=your-registry/atsuite-init@sha256:REPLACE_WITH_64_HEX_DIGEST
# 环境地区不替代 spec.regions；审批时的 --account 必须匹配真实账号/GCP 项目 ID。
# .env 不会自动创建仓库/角色、登录 Docker、配置 gcloud/aliyun，也不代表云验收通过。
