# Copy to .env at the ATSuite repository root, then fill in your own API key.
# .env is ignored by Git. Existing process environment variables take priority.
DEEPSEEK_API_KEY=
ATSUITE_ADVISOR_MODEL=deepseek-flash

# Choose advisor.provider="deepseek" in the experiment spec or the Web form.
# This file configures the recommender Advisor, not trace LLM replay.
